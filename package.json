{
  "name": "shared-blocks",
  "version": "0.1.0",
  "description": "Shared blocks plugin for Obsidian - reuse a block of text across notes, updated live.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test 'tests/*.test.ts'",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
