{
  "name": "shared-blocks",
  "version": "0.2.0",
  "description": "Shared blocks plugin for Obsidian - reuse a block of text across notes, updated live.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test 'tests/*.test.ts'",
    "version": "node version-bump.mjs && git add manifest.json versions.json CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
