{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "importHelpers": true,
    "lib": [
      "ES2019",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "tests"
  ]
}
